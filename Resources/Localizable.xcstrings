    "install.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YAMG does not install dependencies automatically. Copy one command into your terminal, then refresh detection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YAMG 不会自动安装依赖。请复制其中一条命令到终端执行，然后刷新检测。"
          }
        }
      }
    },
    "install.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Mackup"
          }
