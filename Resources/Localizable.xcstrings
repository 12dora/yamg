    "onboarding.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the Mackup CLI and default configuration before running any operation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在运行任何操作前检查 Mackup CLI 和默认配置。"
          }
        }
      }
    },
    "onboarding.cli.status": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackup CLI"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackup CLI"
          }
        }
      }
    },
    "onboarding.cli.available %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available: Mackup %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用：Mackup %@"
          }
        }
      }
    },
    "onboarding.cli.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not installed or not found"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装或未找到"
          }
        }
