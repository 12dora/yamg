    "link_mode.detail" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy mode backup and restore remain the recommended MVP workflow. Link Mode only calls Mackup CLI link commands after explicit confirmation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy mode 的备份和恢复仍是推荐的 MVP 工作流。链接模式只会在明确确认后调用 Mackup CLI link 命令。"
          }
        }
      }
    },
