    "onboarding.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackup readiness"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackup 就绪状态"
          }
        }
      }
    },
    "onboarding.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the Mackup CLI and default configuration before running any operation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在运行任何操作前检查 Mackup CLI 和默认配置。"
          }
        }
      }
    },
    "onboarding.cli.status": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackup CLI"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mackup CLI"
          }
        }
      }
    },
    "onboarding.cli.available %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available: Mackup %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用：Mackup %@"
          }
        }
      }
    },
    "onboarding.cli.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not installed or not found"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未安装或未找到"
          }
        }
      }
    },
    "onboarding.cli.invalid_version": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version output could not be parsed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解析版本输出"
          }
        }
      }
    },
    "onboarding.cli.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查失败"
          }
        }
      }
    },
    "onboarding.cli.unavailable.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Mackup with Homebrew or pipx, or set a custom CLI path later in Preferences."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请通过 Homebrew 或 pipx 安装 Mackup，或稍后在偏好设置中指定 CLI 路径。"
          }
        }
      }
    },
    "onboarding.cli.pending.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app only checks the CLI; it does not run backup, restore, or link operations here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只检查 CLI，不会运行备份、恢复或链接操作。"
          }
        }
      }
    },
    "onboarding.config.status": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration file"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置文件"
          }
        }
      }
    },
    "onboarding.config.present": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已找到"
          }
        }
      }
    },
    "onboarding.config.missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not found yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未找到"
          }
        }
      }
    },
    "onboarding.config.pending.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default path: ~/.mackup.cfg"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认路径：~/.mackup.cfg"
          }
        }
      }
    }
