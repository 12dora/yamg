    "onboarding.cli.unavailable.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Mackup with Homebrew or pipx, or set a custom CLI path later in Preferences."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请通过 Homebrew 或 pipx 安装 Mackup，或稍后在偏好设置中指定 CLI 路径。"
          }
        }
      }
    },
    "onboarding.cli.pending.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app only checks the CLI; it does not run backup, restore, or link operations here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只检查 CLI，不会运行备份、恢复或链接操作。"
          }
        }
      }
    },
